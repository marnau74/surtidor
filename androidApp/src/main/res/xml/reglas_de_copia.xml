<?xml version="1.0" encoding="utf-8"?>
<!-- Los precios se vuelven a descargar: no se copian a la nube ni a otro dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
